PORTICA_CLICKHOUSE_PASSWORD=portica
KEYCLOAK_ADMIN_PASSWORD=admin
PORTICA_GATEWAY_CLIENT_SECRET=portica-gateway-dev-secret
# Development-only AES-256 key for encrypted key value maps (openssl rand -base64 32). Replace it outside local dev.
PORTICA_KVM_ENCRYPTION_KEY=o1r8cXTayN7WvWNLZ8JMcwDzlrd05HPoHb9/reetxkQ=
# Phase 7: secret the gateway adds when it forwards to the AI gateway and MCP service. Replace it outside local dev.
PORTICA_INTERNAL_TOKEN=portica-internal-dev-token
