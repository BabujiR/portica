<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern></encoder>
    </appender>
    <logger name="io.gatling.http.engine.response" level="WARN"/>
    <root level="WARN"><appender-ref ref="CONSOLE"/></root>
</configuration>
