{
  "realm": "portica",
  "displayName": "Portica",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "portica-platform-admin",
        "description": "Operates the Portica installation: creates and archives organizations and has full access to all of them."
      },
      {
        "name": "portica-runtime",
        "description": "Gateways: read runtime configuration (deployed proxies) from the management plane."
      },
      {
        "name": "portica-portal",
        "description": "The developer portal backend: reads the public catalog and manages apps on behalf of signed-in developers."
      }
    ]
  },
  "clients": [
    {
      "clientId": "portica-console",
      "name": "Portica Console",
      "description": "Browser-based admin console (Phase 5). Authorization Code + PKCE.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:5173",
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "portica-management-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "portica-management",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "portica-cli",
      "name": "Portica CLI (local development only)",
      "description": "Password grant for curl/Postman testing on a laptop. Do not enable in shared environments.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "portica-management-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "portica-management",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "portica-gateway",
      "name": "Portica Gateway",
      "description": "Confidential client used by gateways to read runtime configuration (client credentials).",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "portica-gateway-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "portica-management-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "portica-management",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "portica-portal",
      "name": "Portica Developer Portal",
      "description": "Confidential client of portica-portal: calls the management API for developers (client credentials).",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "portica-portal-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "portica-management-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "portica-management",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@portica.local",
      "emailVerified": true,
      "firstName": "Platform",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "portica-platform-admin"
      ]
    },
    {
      "username": "alice",
      "email": "alice@portica.local",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Anderson",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ]
    },
    {
      "username": "bob",
      "email": "bob@portica.local",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Brown",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-portica-gateway",
      "enabled": true,
      "serviceAccountClientId": "portica-gateway",
      "realmRoles": [
        "portica-runtime"
      ]
    },
    {
      "username": "service-account-portica-portal",
      "enabled": true,
      "serviceAccountClientId": "portica-portal",
      "realmRoles": [
        "portica-portal"
      ]
    },
    {
      "username": "dev",
      "email": "dev@portica.local",
      "emailVerified": true,
      "firstName": "Devon",
      "lastName": "Developer",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ]
    }
  ]
}
